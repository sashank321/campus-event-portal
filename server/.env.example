# Server
PORT=5000
NODE_ENV=development

# Database (required)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus_portal?retryWrites=true&w=majority
# Local replica-set example: mongodb://127.0.0.1:27017/campus_portal?replicaSet=rs0
MONGO_URI=

# Client origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Image upload directory (relative to server/)
UPLOAD_DIR=uploads

# JWT (required from Phase 3; required in production)
JWT_SECRET=
JWT_EXPIRES_IN=30m
