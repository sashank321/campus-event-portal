{
    "name":  "campus-event-portal",
    "private":  true,
    "scripts":  {
                    "dev":  "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
                    "dev:server":  "npm run dev -w server",
                    "dev:client":  "npm run dev -w client",
                    "install:all":  "npm install \u0026\u0026 npm install -w server \u0026\u0026 npm install -w client",
                    "seed":  "npm run seed -w server",
                    "indexes":  "npm run indexes -w server"
                },
    "workspaces":  [
                       "server",
                       "client"
                   ],
    "devDependencies":  {
                            "concurrently":  "^9.1.0"
                        },
    "allowScripts":  {
                         "esbuild@0.21.5":  true
                     }
}
